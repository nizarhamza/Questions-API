{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/env.d.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
